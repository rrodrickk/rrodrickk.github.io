---
// Horizontal-scroll TikTok reel. Uses TikTok's official player embed
// (tiktok.com/player/v1/<id>), the lightweight route with no cookie banner
// and no consent wall, same one already live on the site.
const videos = [
  { id: "7646557716323765537" },
  { id: "7666876723996200224" },
  { id: "7661317356408376608" },
  { id: "7656045166393888033" },
  { id: "7609500505114463510" },
  { id: "7588655499273309473" },
];
---

<section id="media" class="media container" data-wayfinder="Media">
  <h2 class="media__heading">Media</h2>

  <div class="media__reel">
    {
      videos.map((v) => (
        <div class="media__slide bezel">
          <span class="bezel__corner bezel__corner--tl" />
          <span class="bezel__corner bezel__corner--tr" />
          <span class="bezel__corner bezel__corner--bl" />
          <span class="bezel__corner bezel__corner--br" />
          <iframe
            class="media__frame"
            src={`https://www.tiktok.com/player/v1/${v.id}?music_info=0&description=0&rel=0`}
            allow="encrypted-media"
            referrerpolicy="no-referrer"
            sandbox="allow-popups allow-popups-to-redirect-new-browser allow-scripts allow-same-origin allow-presentation"
            loading="lazy"
            title="TikTok video"
          />
        </div>
      )
      )
    }

    <a class="media__slide media__slide--more bezel" href="https://www.tiktok.com/@rrodrickk" target="_blank" rel="noopener">
      <span class="bezel__corner bezel__corner--tl" />
      <span class="bezel__corner bezel__corner--tr" />
      <span class="bezel__corner bezel__corner--bl" />
      <span class="bezel__corner bezel__corner--br" />
      <span class="media__more-label font-mono-label">More on TikTok</span>
      <span class="media__more-handle">@rrodrickk ↗</span>
    </a>
  </div>
</section>

<style>
  .media {
    padding-block: var(--space-3xl);
    border-top: var(--rule-hairline) solid var(--color-rule-2);
  }

  .media__heading {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-xl);
    overflow-wrap: anywhere;
  }

  .media__reel {
    display: flex;
    gap: var(--space-lg);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: var(--space-sm);
    scrollbar-width: thin;
  }

  .media__slide {
    position: relative;
    flex: 0 0 auto;
    width: min(78vw, 20rem);
    aspect-ratio: 9 / 16;
    scroll-snap-align: start;
    overflow: hidden;
  }

  .media__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .media__slide--more {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    text-decoration: none;
    color: var(--color-ink);
    background: var(--color-paper-2);
    transition: border-color var(--dur-short) var(--ease-out);
  }
  .media__slide--more:hover { border-color: var(--color-accent); }

  .media__more-label { color: var(--color-muted); }
  .media__more-handle { font-size: var(--text-lg); font-weight: 700; }
</style>
