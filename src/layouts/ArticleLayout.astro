---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} - rrodrickk</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" type="image/png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bitcount+Single:wght@400..900&family=IBM+Plex+Sans:wght@350;400;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <canvas id="res-canvas" aria-hidden="true"></canvas>
    <script type="module" src="/style/perlin.js"></script>

    <header class="article-bar">
      <div class="article-bar__inner container">
        <a href="/" class="article-bar__title">rrodrickk<span class="nav__dot">.</span> blogs</a>
        <a class="article-bar__link" href="/blog/">← Blog Index</a>
      </div>
    </header>

    <main>
      <slot />
    </main>
  </body>
</html>
